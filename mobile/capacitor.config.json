{
  "appId": "fm.wavelength.app",
  "appName": "Wavelength",
  "webDir": "../frontend/out",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://mohamednavith.github.io/Spotify-Craft/",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#121212",
      "showSpinner": false
    }
  }
}
