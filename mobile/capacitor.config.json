{
  "appId": "fm.wavelength.app",
  "appName": "Wavelength",
  "webDir": "../frontend/out",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#121212"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#121212",
      "showSpinner": false
    }
  }
}
