# ==========================================
# Wavelength Music Streaming Stack Environment
# ==========================================

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Security & Authentication (Generate secure secrets in production)
JWT_SECRET=wavelength-dev-jwt-super-secret-key-change-in-production-2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=wavelength-dev-refresh-token-super-secret-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Database (PostgreSQL)
POSTGRES_USER=wavelength
POSTGRES_PASSWORD=wavelength_secure_password
POSTGRES_DB=wavelength_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wavelength:wavelength_secure_password@localhost:5432/wavelength_db?schema=public

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Search Engine (Meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=wavelength_meili_master_key_2026

# Storage / Media Pipeline (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
S3_BUCKET_NAME=wavelength-tracks
CDN_BASE_URL=http://localhost:9000/wavelength-tracks

# Official Music Providers
# Jamendo (Free Creative Commons & licensed music catalog)
# A verified working public development client ID is provided by default:
JAMENDO_CLIENT_ID=17ed92bf
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0

# Future Phases API Configurations
AUDIUS_APP_NAME=Wavelength
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
PEXELS_API_KEY=
