# ==========================================
# Wavelength Discord Music Bot Configuration
# ==========================================

# 1. Discord Bot Token & Client ID
# Obtain these from: https://discord.com/developers/applications
# - Create a new Application -> Bot -> Reset Token -> Copy
# - General Information -> Copy Application ID
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here

# 2. Bot Customization & Defaults
DEFAULT_PREFIX=!w
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=1000
IDLE_TIMEOUT_SECONDS=180

# 3. Wavelength Web Player Link (Displayed in Rich Embeds)
WAVELENGTH_WEB_URL=https://mohamednavith.github.io/Spotify-Craft/

# 4. Optional: Spotify API Credentials (for extended Spotify metadata lookup)
# Register at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
