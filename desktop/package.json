{
  "name": "wavelength-desktop",
  "version": "1.0.0",
  "description": "Wavelength Spotify-style Desktop Player for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "build": {
    "appId": "fm.wavelength.desktop",
    "productName": "Wavelength",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    }
  }
}
