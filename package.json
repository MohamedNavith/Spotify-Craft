{
  "name": "wavelength-monorepo",
  "version": "1.0.0",
  "description": "Wavelength Spotify-Grade Music Streaming Ecosystem",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
